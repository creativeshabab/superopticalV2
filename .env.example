# ==============================================================================
# SUPER OPTICAL V2 — ENVIRONMENT TEMPLATE
# DO NOT ADD PRODUCTION CREDENTIALS OR SECRETS TO THIS FILE
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Multi-Tenant & Security
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_string
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=replace_with_32_character_base64_encryption_key

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=super_optical_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# Object Storage (S3 / MinIO / Local)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=super-optical-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Notifications — WhatsApp (Meta Cloud API / Twilio)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Notifications — SMS Provider
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SPOPTC

# Notifications — Email (SMTP)
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Super Optical <noreply@superoptical.local>"

# Client Applications
WEB_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,tauri://localhost
